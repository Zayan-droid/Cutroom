# Optional mock backend controls. Copy to .env.local and restart Vite.
# Omit the seed for fresh randomness on each run.
VITE_MOCK_ENGINE_SEED=cutroom-demo
# random (approximately 1/8 failure), success, or failure
VITE_MOCK_ENGINE_OUTCOME=random
# 1 = drafts in 1–3 seconds, renders in 5–10 seconds; 0 = async immediate
VITE_MOCK_ENGINE_TIME_SCALE=1

# Optional story-agent (Half 1) controls. Same shape as the mock engine above.
# Omit the seed for fresh randomness; content is still deterministic per prompt.
VITE_STORY_ENGINE_SEED=cutroom-story
# random (approximately 1/8 failure), success, or failure
VITE_STORY_ENGINE_OUTCOME=random
# scales compose latency; 0 = async immediate
VITE_STORY_ENGINE_TIME_SCALE=1
