# ============================================================================
# Cutroom backend — real generation engine
# Copy this file to  backend/.env  and paste your keys. NEVER commit backend/.env
# (it is gitignored). Only this .example template belongs in git.
# ============================================================================

# ---- Server ---------------------------------------------------------------
PORT=8787
# Lock CORS to your deployed frontend (and localhost for dev). Comma-separated.
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ============================================================================
# TEXT  —  story script / prompt -> beats -> dialogue
# Provider: Groq (free, fast).   Get a key: https://console.groq.com/keys
# ============================================================================
GROQ_API_KEY=
# Model ids rotate — check the live list at https://console.groq.com/docs/models
# (or GET https://api.groq.com/openai/v1/models). A good current default:
GROQ_MODEL=openai/gpt-oss-120b

# ============================================================================
# IMAGE  —  scene stills / draft frames  (SDXL default, FLUX toggle)
# Provider: Cloudflare Workers AI (free tier incl. SDXL + FLUX-schnell).
#   1. Account ID:  https://dash.cloudflare.com  (Workers & Pages -> Overview, right sidebar)
#   2. API token :  https://dash.cloudflare.com/profile/api-tokens
#                   -> Create Token -> "Workers AI" template (Account > Workers AI > Read)
# ============================================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Model catalog: https://developers.cloudflare.com/workers-ai/models/
# SDXL (default):  @cf/stabilityai/stable-diffusion-xl-base-1.0
# FLUX (quality):  @cf/black-forest-labs/flux-1-schnell
# SDXL-Lightning:  @cf/bytedance/stable-diffusion-xl-lightning
IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0

# ============================================================================
# VIDEO  —  text/image -> short clip  (needs a GPU provider; this is the
# part that actually costs money once trial credits run out). Pick ONE.
# ============================================================================
# Option A (default): fal.ai     Get a key: https://fal.ai/dashboard/keys
FAL_KEY=
# Model: https://fal.ai/models   e.g. fal-ai/ltx-video  or  fal-ai/stable-video-diffusion
FAL_VIDEO_MODEL=fal-ai/ltx-video
#
# Option B (alt): Replicate      Get a token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# e.g. lightricks/ltx-video  (https://replicate.com/explore)

# ============================================================================
# STORAGE / CACHE  —  recommended: cache every generated asset so repeat
# visits (and judges clicking around) cost $0. Cloudflare R2 (10 GB free).
#   R2 tokens: https://dash.cloudflare.com  -> R2 -> Manage R2 API Tokens
# ============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cutroom-assets
# Public bucket URL or custom domain (for serving cached assets to the frontend)
R2_PUBLIC_URL=

# ============================================================================
# OPTIONAL
# ============================================================================
# Hugging Face — only if you want a model the providers above don't host.
# Token: https://huggingface.co/settings/tokens   (its free tier is ~$0.10/mo)
HUGGINGFACE_API_KEY=

# TTS (narration) is self-hosted on the box with Kokoro or Piper — NO key needed.
#   Kokoro: https://huggingface.co/hexgrad/Kokoro-82M
#   Piper : https://github.com/rhasspy/piper
